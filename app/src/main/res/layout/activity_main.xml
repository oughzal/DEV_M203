<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:padding="45dp"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    tools:context=".MainActivity">


<ImageView
    android:id="@+id/imgOFPPT"
    android:layout_width="50dp"
    android:layout_height="50dp"
    android:layout_marginBottom="30dp"
    android:src="@drawable/ofppt" />
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Animation"
        android:id="@+id/btnViewAnimation" />
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ObjectAnimation"
        android:id="@+id/btnObjectAnimation"
        android:layout_marginTop="20dp" />
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="go to Activity 2"
        android:id="@+id/btnActivity2" />
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="go to Activity 3"
        android:id="@+id/btnActivity3"
        android:layout_marginTop="20dp" />

</LinearLayout>